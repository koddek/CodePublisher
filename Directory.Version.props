<Project>
  <!--
    Central version manager: the single source of truth for every project,
    assembly, and macOS app bundle in this repository.
    Bump the four values below together; nothing else should hardcode a version.
    Imported by the repo-root Directory.Build.props (every project).
  -->
  <PropertyGroup>
    <Version>0.12.2</Version>
    <AssemblyVersion>0.12.2.0</AssemblyVersion>
    <FileVersion>0.12.2.0</FileVersion>
    <InformationalVersion>0.12.2</InformationalVersion>
  </PropertyGroup>
</Project>
