<Project>
  <!--
    Central package management: the single source of truth for every NuGet
    package version in this repository (production projects and tests).
    Projects declare <PackageReference Include="X"/> with no version; the
    version comes from here. Bump a version in exactly one place: below.
    https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia packages -->
    <!-- Important: keep version in sync! -->
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <!-- Avalonia.Diagnostics has no 12.x release; 11.3.23 is the latest published line. -->
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.23" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.iOS" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- QR encoding for the Android wireless "Pair with QR code" flow. The PngByteQRCode renderer is
         pure managed (no System.Drawing). -->
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <!-- SkiaSharp and HarfBuzzSharp must stay on the versions Avalonia.Skia pins (3.119.4 / 8.3.1.3
         for Avalonia 12.1.6), not the latest published SkiaSharp line: Avalonia's renderers and
         native assets are compiled against that SkiaSharp line, and a major bump breaks the pairing. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- Test framework -->
    <PackageVersion Include="TUnit" Version="1.83.0" />
  </ItemGroup>
</Project>
