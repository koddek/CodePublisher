<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>CodePublisher.Desktop</string>
  <key>CFBundleIdentifier</key>
  <string>com.codepublisher</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Code Publisher</string>
  <key>CFBundleDisplayName</key>
  <string>Code Publisher</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <!-- Version values are placeholders. The build stamps both from $(Version) in
       the central version manager (see StampMacBundleVersion in
       CodePublisher.Desktop.csproj), so they always match the assembly. -->
  <key>CFBundleShortVersionString</key>
  <string>0.0.0</string>
  <key>CFBundleVersion</key>
  <string>0.0.0</string>
  <key>CFBundleIconFile</key>
  <string>codepublisher.icns</string>
  <key>CFBundleIconName</key>
  <string>codepublisher</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- macOS 15 and newer gate outgoing connections to other devices on the local network on this
       declaration. Without it the system denies the app's LAN traffic silently (BSD sockets fail
       with "No route to host") and never lists the app under System Settings > Privacy & Security >
       Local Network, so the user has nothing to switch on. adb is launched by this app and is
       attributed to it, so the app's access is what the pairing and debugging connections use.
       The Bonjour entries are the two service types Wireless debugging advertises. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Code Publisher talks to your Android phones and emulators over your local network: it discovers them through Wi-Fi debugging, pairs with them, and deploys and inspects apps on them.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_adb-tls-pairing._tcp</string>
    <string>_adb-tls-connect._tcp</string>
  </array>
</dict>
</plist>
