<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DotNetAppPublisher.App"
             Name=".NET App Publisher"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://DotNetAppPublisher/Styles/AppStyles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Dark Theme: Black and Grays -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Primary surfaces -->
                    <SolidColorBrush x:Key="ThemeBackgroundColor">#1A1A1A</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceColor">#242424</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceVariantColor">#2D2D2D</SolidColorBrush>
                    
                    <!-- Text & Foreground -->
                    <SolidColorBrush x:Key="ThemeForegroundColor">#E0E0E0</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondaryColor">#A0A0A0</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTertiaryColor">#A0A0A0</SolidColorBrush>
                    
                    <!-- Accents -->
                    <SolidColorBrush x:Key="PrimaryAccentColor">#0078D4</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessColor">#107C10</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningColor">#FFB900</SolidColorBrush>
                    <SolidColorBrush x:Key="ErrorColor">#F4373F</SolidColorBrush>
                    
                    <!-- Status badges & warning banner (dark variants) -->
                    <SolidColorBrush x:Key="AdbBadgeBackgroundColor">#1E3320</SolidColorBrush>
                    <SolidColorBrush x:Key="AdbBadgeBorderColor">#4CAF50</SolidColorBrush>
                    <SolidColorBrush x:Key="AdbBadgeTextColor">#7BC47F</SolidColorBrush>
                    <SolidColorBrush x:Key="EmulatorBadgeBackgroundColor">#16283D</SolidColorBrush>
                    <SolidColorBrush x:Key="EmulatorBadgeBorderColor">#2196F3</SolidColorBrush>
                    <SolidColorBrush x:Key="EmulatorBadgeTextColor">#64B5F6</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBannerBackgroundColor">#3A2E1A</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBannerBorderColor">#8A6D3B</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBannerTextColor">#E8B450</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBannerBackgroundColor">#1B2A41</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBannerBorderColor">#3B6FA0</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBannerTextColor">#7FB3E8</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusSuccessBackgroundColor">#1E3320</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusSuccessBorderColor">#4CAF50</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusSuccessTextColor">#7BC47F</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusWarningBackgroundColor">#3A2E1A</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusWarningBorderColor">#8A6D3B</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusWarningTextColor">#E8B450</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusErrorBackgroundColor">#3B1D20</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusErrorBorderColor">#A33A40</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusErrorTextColor">#F08A8E</SolidColorBrush>
                    
                    <!-- Borders -->
                    <SolidColorBrush x:Key="BorderColor">#3D3D3D</SolidColorBrush>
                </ResourceDictionary>
                
                <!-- Light Theme: White and Grays -->
                <ResourceDictionary x:Key="Light">
                    <!-- Primary surfaces -->
                    <SolidColorBrush x:Key="ThemeBackgroundColor">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceColor">#F8F8F8</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceVariantColor">#EEEEEE</SolidColorBrush>
                    
                    <!-- Text & Foreground -->
                    <SolidColorBrush x:Key="ThemeForegroundColor">#1F1F1F</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondaryColor">#5F5F5F</SolidColorBrush>
                    <SolidColorBrush x:Key="TextTertiaryColor">#6B6B6B</SolidColorBrush>
                    
                    <!-- Accents -->
                    <SolidColorBrush x:Key="PrimaryAccentColor">#0078D4</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessColor">#107C10</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningColor">#D97706</SolidColorBrush>
                    <SolidColorBrush x:Key="ErrorColor">#D32F2F</SolidColorBrush>
                    
                    <!-- Status badges & warning banner (light variants) -->
                    <SolidColorBrush x:Key="AdbBadgeBackgroundColor">#E8F5E9</SolidColorBrush>
                    <SolidColorBrush x:Key="AdbBadgeBorderColor">#4CAF50</SolidColorBrush>
                    <SolidColorBrush x:Key="AdbBadgeTextColor">#2E7D32</SolidColorBrush>
                    <SolidColorBrush x:Key="EmulatorBadgeBackgroundColor">#E3F2FD</SolidColorBrush>
                    <SolidColorBrush x:Key="EmulatorBadgeBorderColor">#2196F3</SolidColorBrush>
                    <SolidColorBrush x:Key="EmulatorBadgeTextColor">#1565C0</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBannerBackgroundColor">#FFF6E5</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBannerBorderColor">#E0A832</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBannerTextColor">#8A5A00</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBannerBackgroundColor">#E8F0FE</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBannerBorderColor">#8AB4F8</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBannerTextColor">#1967D2</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusSuccessBackgroundColor">#E8F5E9</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusSuccessBorderColor">#4CAF50</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusSuccessTextColor">#2E7D32</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusWarningBackgroundColor">#FFF6E5</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusWarningBorderColor">#E0A832</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusWarningTextColor">#8A5A00</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusErrorBackgroundColor">#FDECEC</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusErrorBorderColor">#D66565</SolidColorBrush>
                    <SolidColorBrush x:Key="StatusErrorTextColor">#A31515</SolidColorBrush>
                    
                    <!-- Borders -->
                    <SolidColorBrush x:Key="BorderColor">#D0D0D0</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
